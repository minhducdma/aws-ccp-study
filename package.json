{
  "name": "study-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "verify": "turbo run verify",
    "smoke": "turbo run smoke",
    "mock-exams": "pnpm --filter @study/content run mock-exams",
    "preview:pages": "turbo run build && pnpm --filter @study/web run preview:pages"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}

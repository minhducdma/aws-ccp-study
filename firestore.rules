rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one progress document, keyed by their own uid.
    // Nobody, including other authenticated users, can read or write someone else's progress.
    match /userProgress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

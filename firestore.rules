rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /userProgress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /courses/{courseId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /attempts/{attemptId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
